{
	"name": "n8n-nodes-fiscaldata",
	"version": "0.0.3",
	"description": "n8n community node to query the U.S. Treasury Fiscal Data API (fiscaldata.treasury.gov)",
	"license": "MIT",
	"homepage": "https://github.com/Jaldekoa/n8n-nodes-fiscaldata",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"fiscaldata",
		"treasury",
		"us-treasury",
		"federal-debt"
	],
	"author": {
		"name": "Jon Aldekoa",
		"email": "jaldekoa@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Jaldekoa/n8n-nodes-fiscaldata.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"generate:catalog": "node scripts/generate-catalog.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/FiscalData/FiscalData.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
